{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sub-reality.example/contract/v0.1/event.schema.json",
  "title": "Event v0.1",
  "description": "An immutable fact recorded by the core. Ordered by 'cursor'. Payloads are minimal and redacted; artifact bodies are fetched separately.",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "schema_version", "cursor", "ts", "office", "type", "simulation", "payload"],
  "properties": {
    "event_id": {"type": "string", "minLength": 8},
    "schema_version": {"const": "0.1"},
    "cursor": {"type": "integer", "minimum": 1},
    "ts": {"type": "string", "format": "date-time"},
    "office": {"enum": ["okfilm", "institute", "school"]},
    "project": {"type": ["string", "null"]},
    "task_id": {"type": ["string", "null"]},
    "run_id": {"type": ["string", "null"]},
    "type": {"enum": [
      "task.created", "task.queued", "run.started", "tool.called", "evidence.recorded",
      "artifact.written", "run.completed", "run.failed", "task.awaiting_review", "task.awaiting_approval",
      "approval.recorded", "task.accepted", "task.revision_requested",
      "task.cancel_requested", "task.cancelled", "transfer.recorded", "lesson.attempt_recorded"]},
    "simulation": {"type": "boolean"},
    "payload": {"type": "object"},
    "artifact_ref": {
      "type": "object", "additionalProperties": false, "required": ["artifact_id", "sha256"],
      "properties": {"artifact_id": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    }
  }
}
